//@version=6
// =============================================================================
// ICT (Inner Circle Trader) concepts as one rule-based model
//
//   1. Liquidity    : previous day H/L, Asia H/L, London H/L, 1h swing H/L
//   2. Sweep        : price trades through one of those levels
//   3. Confirmation : 5m break of structure (candle CLOSE through the most
//                     recent swing) and/or an inverse fair value gap
//   4. Entry        : on the confirmation close, or a limit order on the
//                     retrace into the FVG / order block / breaker it created
//   5. Filters      : 1h trend (last 1h BOS), premium/discount of the 1h
//                     dealing range, SMT divergence vs a correlated market
//   6. Risk         : stop beyond the sweep extreme, fixed R:R target,
//                     % equity risk sizing, NY entry window
//
// RUN ON THE 5-MINUTE CHART (MES1! recommended; SMT compares against MNQ1!).
// =============================================================================
strategy("SMC Model, ICT concepts (Sweep → BOS/IFVG → Entry)", overlay = true,
     initial_capital = 100000, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 1.0,
     slippage = 1, calc_on_every_tick = false, process_orders_on_close = false,
     max_bars_back = 500,
     // Futures are margined, not paid in full. Pine v6 defaults to 100% margin,
     // which silently rejects any order larger than account cash. 10% is a
     // conservative stand-in for MES intraday/initial margin; adjust to your broker.
     margin_long = 10, margin_short = 10)

// ---------------------------- Inputs ----------------------------------------
gT = "Session"
startHr      = input.int(8, "Entry window start hour (ET)", minval = 0, maxval = 23, group = gT)
startMin     = input.int(0, "Entry window start minute", minval = 0, maxval = 59, group = gT)
endHr        = input.int(11, "Entry window end hour (ET, exclusive)", minval = 0, maxval = 23, group = gT)
endMin       = input.int(0, "Entry window end minute", minval = 0, maxval = 59, group = gT)
flattenAtEnd = input.bool(true, "Flatten open trades at the end of the window", group = gT)
maxTradesDay = input.int(2, "Max trades per day", minval = 1, group = gT)
useNews      = input.bool(true, "Skip news days (dates listed below)", group = gT)
newsDates    = input.text_area("", "Blocked dates, format YYYY-MM-DD, one per line", group = gT)

gL = "Liquidity (levels that can be swept)"
usePrevDay = input.bool(true, "Previous day high / low", group = gL)
useAsia    = input.bool(true, "Asia session high / low (20:00–00:00 ET)", group = gL)
useLondon  = input.bool(true, "London session high / low (02:00–05:00 ET)", group = gL)
useHtfSw   = input.bool(true, "1h swing highs / lows", group = gL)
htfLen     = input.int(2, "1h swing strength (bars each side)", minval = 1, group = gL)
setupBars  = input.int(36, "A sweep stays valid for (5m bars)", minval = 1, group = gL)

gC = "Confirmation (5m reversal)"
confMode = input.string("BOS or IFVG", "Confirmation", options = ["BOS", "IFVG", "BOS or IFVG"], group = gC)
pivLen5  = input.int(3, "5m swing strength (bars each side)", minval = 1, group = gC)
ifvgLook = input.int(24, "IFVG: gap formed at most this many bars before the sweep", minval = 1, group = gC)

gE = "Entry"
entryMode   = input.string("Confirmation close", "Entry",
     options = ["Confirmation close", "Retrace into FVG", "Retrace into order block", "Retrace into breaker"], group = gE)
entryExpiry = input.int(12, "Cancel an unfilled limit order after (5m bars)", minval = 1, group = gE)

gF = "Filters"
useBias = input.bool(true, "Only trade with the 1h trend (direction of last 1h BOS)", group = gF)
usePDA  = input.bool(false, "Longs only in discount, shorts only in premium (1h range)", group = gF)
useSMT  = input.bool(false, "Require SMT divergence", group = gF)
smtSym  = input.symbol("CME_MINI:MNQ1!", "SMT comparison symbol", group = gF)

gR = "Risk"
targetRR   = input.float(1.5, "Take profit (reward:risk)", minval = 0.1, step = 0.25, group = gR)
stopBuf    = input.float(0.0, "Stop buffer beyond the sweep extreme (points)", minval = 0.0, step = 0.25, group = gR)
riskPct    = input.float(1.0, "Risk per trade (% of equity)", minval = 0.05, step = 0.05, group = gR)
minRiskAtr = input.float(0.3, "Skip if risk < this many ATR(14, 5m)", minval = 0.0, step = 0.1, group = gR)
maxQty     = input.int(100, "Max contracts per trade", minval = 1, group = gR)

gD = "Display"
showLevels = input.bool(true, "Show liquidity levels", group = gD)
showDiag   = input.bool(true, "Show funnel table", group = gD)

// ---------------------------- Time ------------------------------------------
tz = "America/New_York"

f_min(int t) =>
    hour(t, tz) * 60 + minute(t, tz)

inWin(int t) =>
    int m = f_min(t)
    int d = dayofweek(t, tz)
    m >= startHr * 60 + startMin and m < endHr * 60 + endMin and d != dayofweek.saturday and d != dayofweek.sunday

string dayStr    = str.format_time(time, "yyyy-MM-dd", tz)
bool newsBlocked = useNews and str.contains(newsDates, dayStr)
bool canTrade    = inWin(time) and not newsBlocked
bool holdNext    = inWin(time_close) and not newsBlocked
bool newDay      = timeframe.change("D")

int  nowMin   = f_min(time)
bool inAsia   = nowMin >= 20 * 60
bool inLondon = nowMin >= 2 * 60 and nowMin < 5 * 60

// ---------------------------- Higher-timeframe data -------------------------
// Previous day high/low (non-repainting: prior completed day only)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// 1h swings and 1h trend. Trend = direction of the last 1h candle CLOSE beyond
// the most recent 1h swing (Boot Camp BOS definition). Values are from the
// last COMPLETED 1h bar, so nothing repaints.
f_htf() =>
    float ph  = ta.pivothigh(high, htfLen, htfLen)
    float pl  = ta.pivotlow(low, htfLen, htfLen)
    float lph = ta.valuewhen(not na(ph), ph, 0)
    float lpl = ta.valuewhen(not na(pl), pl, 0)
    var int tr = 0
    if not na(lph) and close > lph
        tr := 1
    else if not na(lpl) and close < lpl
        tr := -1
    [lph[1], lpl[1], tr[1]]

[hSwH, hSwL, hTrend] = request.security(syminfo.tickerid, "60", f_htf(), lookahead = barmerge.lookahead_on)

// Comparison market for SMT (same timeframe, completed bars)
f_comp() =>
    float cph = ta.pivothigh(high, pivLen5, pivLen5)
    float cpl = ta.pivotlow(low, pivLen5, pivLen5)
    [high, low, ta.valuewhen(not na(cph), cph, 0), ta.valuewhen(not na(cpl), cpl, 0)]

[cH, cL, cLastPH, cLastPL] = request.security(smtSym, timeframe.period, f_comp())

float atrV = ta.atr(14)

// ---------------------------- Session ranges --------------------------------
var float curAH = na
var float curAL = na
var float asiaH = na
var float asiaL = na
var bool  asiaHT = false
var bool  asiaLT = false

var float curLH = na
var float curLL = na
var float lonH = na
var float lonL = na
var bool  lonHT = false
var bool  lonLT = false

if inAsia and not inAsia[1]
    curAH := high
    curAL := low
else if inAsia
    curAH := na(curAH) ? high : math.max(curAH, high)
    curAL := na(curAL) ? low : math.min(curAL, low)
if not inAsia and inAsia[1] and not na(curAH)
    asiaH := curAH
    asiaL := curAL
    asiaHT := open > asiaH
    asiaLT := open < asiaL

if inLondon and not inLondon[1]
    curLH := high
    curLL := low
else if inLondon
    curLH := na(curLH) ? high : math.max(curLH, high)
    curLL := na(curLL) ? low : math.min(curLL, low)
if not inLondon and inLondon[1] and not na(curLH)
    lonH := curLH
    lonL := curLL
    lonHT := open > lonH
    lonLT := open < lonL

// Previous-day levels refresh at the start of each trading day
var bool pdhT = false
var bool pdlT = false
if newDay
    pdhT := open > pdh
    pdlT := open < pdl

// 1h swing levels refresh whenever a new 1h swing is confirmed
var bool hSwHT = false
var bool hSwLT = false
if not na(hSwH) and (na(hSwH[1]) or hSwH != hSwH[1])
    hSwHT := open > hSwH
if not na(hSwL) and (na(hSwL[1]) or hSwL != hSwL[1])
    hSwLT := open < hSwL

// ---------------------------- Sweeps ----------------------------------------
f_hit(bool on, float lvl, bool taken, bool isHigh) =>
    on and not taken and not na(lvl) and (isHigh ? high > lvl : low < lvl)

bool swPDH = f_hit(usePrevDay, pdh, pdhT, true)
bool swPDL = f_hit(usePrevDay, pdl, pdlT, false)
bool swAH  = f_hit(useAsia, asiaH, asiaHT, true)
bool swAL  = f_hit(useAsia, asiaL, asiaLT, false)
bool swLH  = f_hit(useLondon, lonH, lonHT, true)
bool swLL  = f_hit(useLondon, lonL, lonLT, false)
bool swHH  = f_hit(useHtfSw, hSwH, hSwHT, true)
bool swHL  = f_hit(useHtfSw, hSwL, hSwLT, false)

if swPDH
    pdhT := true
if swPDL
    pdlT := true
if swAH
    asiaHT := true
if swAL
    asiaLT := true
if swLH
    lonHT := true
if swLL
    lonLT := true
if swHH
    hSwHT := true
if swHL
    hSwLT := true

bool hiSweep = swPDH or swAH or swLH or swHH    // buy-side taken → look for shorts
bool loSweep = swPDL or swAL or swLL or swHL    // sell-side taken → look for longs

// ---------------------------- 5m structure and gaps -------------------------
float ph5 = ta.pivothigh(high, pivLen5, pivLen5)
float pl5 = ta.pivotlow(low, pivLen5, pivLen5)
var float lastSH5 = na
var float lastSL5 = na
var int   lastSH5Bar = na
var int   lastSL5Bar = na
if not na(ph5)
    lastSH5 := ph5
    lastSH5Bar := bar_index - pivLen5
if not na(pl5)
    lastSL5 := pl5
    lastSL5Bar := bar_index - pivLen5

// Most recent bullish and bearish 5m fair value gaps
var float bullTop = na
var float bullBot = na
var int   bullBar = na
var float bearTop = na
var float bearBot = na
var int   bearBar = na

// Most recent candle in direction `wantUp` between offsets fromK..toK (newest first). -1 if none.
f_lastCandle(int fromK, int toK, bool wantUp) =>
    int found = -1
    if toK >= fromK and fromK >= 0
        for k = fromK to toK
            if (wantUp and close[k] > open[k]) or (not wantUp and close[k] < open[k])
                found := k
                break
    found

// ---------------------------- Setup state -----------------------------------
var bool  sOn = false
var int   sArm = na
var float sExt = na
var float sCRef = na
var float sCExt = na

var bool  lOn = false
var int   lArm = na
var float lExt = na
var float lCRef = na
var float lCExt = na

var int   pendDir = 0
var int   pendBar = na
var float pendTP = na
var int   lastOrdDir = 0
var float tradeTP = na
var float tradeSL = na
var int   tradesToday = 0

// Funnel counters
var int nSwL = 0
var int nSwS = 0
var int nConfL = 0
var int nConfS = 0
var int nBlkL = 0
var int nBlkS = 0
var int nWinL = 0
var int nWinS = 0
var int nBiasL = 0
var int nBiasS = 0
var int nSmtL = 0
var int nSmtS = 0
var int nZoneL = 0
var int nZoneS = 0
var int nPdaL = 0
var int nPdaS = 0
var int nRiskL = 0
var int nRiskS = 0
var int nOrdL = 0
var int nOrdS = 0
var int nFillL = 0
var int nFillS = 0
var int nCxlL = 0
var int nCxlS = 0

if newDay
    tradesToday := 0

// Fill detection that also catches a trade opened and closed in the same bar
int  totalTr  = strategy.closedtrades + strategy.opentrades
bool filledNow = totalTr > nz(totalTr[1])
if filledNow
    tradesToday += 1
    if lastOrdDir == 1
        nFillL += 1
    if lastOrdDir == -1
        nFillS += 1

// Arm / extend setups
if hiSweep
    if not sOn
        sCRef := cLastPH
        sCExt := cH
        sExt := high
        nSwS += 1
    else
        sExt := math.max(sExt, high)
        sCExt := math.max(sCExt, cH)
    sOn := true
    sArm := bar_index
else if sOn
    sExt := math.max(sExt, high)
    sCExt := math.max(sCExt, cH)
    if bar_index - sArm > setupBars
        sOn := false

if loSweep
    if not lOn
        lCRef := cLastPL
        lCExt := cL
        lExt := low
        nSwL += 1
    else
        lExt := math.min(lExt, low)
        lCExt := math.min(lCExt, cL)
    lOn := true
    lArm := bar_index
else if lOn
    lExt := math.min(lExt, low)
    lCExt := math.min(lCExt, cL)
    if bar_index - lArm > setupBars
        lOn := false

// ---------------------------- Pending limit orders --------------------------
if pendDir != 0
    if filledNow or strategy.position_size != 0
        pendDir := 0
    else if bar_index - pendBar >= entryExpiry or not holdNext or (pendDir == 1 and high >= pendTP) or (pendDir == -1 and low <= pendTP)
        strategy.cancel(pendDir == 1 ? "Long" : "Short")
        if pendDir == 1
            nCxlL += 1
        else
            nCxlS += 1
        pendDir := 0

if not holdNext and flattenAtEnd
    strategy.close_all(comment = "Flat at window end")

// ---------------------------- Confirmation ----------------------------------
bool bosL  = lOn and bar_index > lArm and not na(lastSH5) and close > lastSH5 and close[1] <= lastSH5
bool bosS  = sOn and bar_index > sArm and not na(lastSL5) and close < lastSL5 and close[1] >= lastSL5
// IFVG: a gap left by the move INTO the sweep gets closed through the other way
bool ifvgL = lOn and bar_index > lArm and not na(bearTop) and bearBar >= lArm - ifvgLook and close > bearTop and close[1] <= bearTop
bool ifvgS = sOn and bar_index > sArm and not na(bullBot) and bullBar >= sArm - ifvgLook and close < bullBot and close[1] >= bullBot

bool confL = confMode == "BOS" ? bosL : confMode == "IFVG" ? ifvgL : (bosL or ifvgL)
bool confS = confMode == "BOS" ? bosS : confMode == "IFVG" ? ifvgS : (bosS or ifvgS)

// Gap bookkeeping (after the IFVG checks so this bar's own gap isn't used for inversion)
if not na(bullBot) and close < bullBot
    bullTop := na
    bullBot := na
    bullBar := na
if not na(bearTop) and close > bearTop
    bearTop := na
    bearBot := na
    bearBar := na
if low > high[2]
    bullTop := low
    bullBot := high[2]
    bullBar := bar_index
if high < low[2]
    bearTop := low[2]
    bearBot := high
    bearBar := bar_index

bool isLimit  = entryMode != "Confirmation close"
bool canPlace = canTrade and holdNext and strategy.position_size == 0 and pendDir == 0 and tradesToday < maxTradesDay
bool placed   = false

// ---------------------------- Long ------------------------------------------
if confL
    nConfL += 1
    lOn := false                       // one attempt per sweep
    if not (canTrade and holdNext)
        nWinL += 1
    else if not canPlace
        nBlkL += 1
    else if useBias and hTrend != 1
        nBiasL += 1
    else if useSMT and (na(lCRef) or lCExt < lCRef)
        nSmtL += 1                     // comparison market also made a lower low → no SMT
    else
        float lvl = na
        if not isLimit
            lvl := close
        else if entryMode == "Retrace into FVG"
            if not na(bullBot) and bullBar >= lArm
                lvl := bullTop         // near edge of the bullish FVG left by the displacement
        else if entryMode == "Retrace into order block"
            int k = f_lastCandle(1, math.min(bar_index - lArm + 3, 300), false)
            if k > 0
                lvl := high[k]         // last down-close candle before the move up
        else
            if bosL and not na(lastSH5Bar)
                int k0 = bar_index - lastSH5Bar
                int k = f_lastCandle(k0, math.min(k0 + 5, 300), true)
                if k >= 0
                    lvl := high[k]     // last up-close candle at the high that was broken
        if isLimit and not na(lvl) and lvl >= close
            lvl := na                  // must be a pullback below current price
        if na(lvl)
            nZoneL += 1
        else if usePDA and not (not na(hSwH) and not na(hSwL) and hSwH > hSwL and lvl < (hSwH + hSwL) / 2)
            nPdaL += 1
        else
            float stopPx  = math.round_to_mintick(lExt - stopBuf)
            float riskPts = lvl - stopPx
            float tpPx    = math.round_to_mintick(lvl + targetRR * riskPts)
            if not (riskPts > 0 and riskPts >= minRiskAtr * atrV) or (isLimit and close >= tpPx)
                nRiskL += 1
            else
                int qty = int(math.min(maxQty, math.max(1, math.floor(strategy.equity * riskPct / 100 / (riskPts * syminfo.pointvalue)))))
                if isLimit
                    strategy.entry("Long", strategy.long, qty = qty, limit = math.round_to_mintick(lvl))
                    pendDir := 1
                    pendBar := bar_index
                    pendTP := tpPx
                else
                    strategy.entry("Long", strategy.long, qty = qty)
                strategy.exit("Long exit", from_entry = "Long", stop = stopPx, limit = tpPx)
                tradeTP := tpPx
                tradeSL := stopPx
                lastOrdDir := 1
                placed := true
                nOrdL += 1

// ---------------------------- Short -----------------------------------------
if confS
    nConfS += 1
    sOn := false
    if not (canTrade and holdNext)
        nWinS += 1
    else if not canPlace or placed
        nBlkS += 1
    else if useBias and hTrend != -1
        nBiasS += 1
    else if useSMT and (na(sCRef) or sCExt > sCRef)
        nSmtS += 1                     // comparison market also made a higher high → no SMT
    else
        float lvl = na
        if not isLimit
            lvl := close
        else if entryMode == "Retrace into FVG"
            if not na(bearTop) and bearBar >= sArm
                lvl := bearBot
        else if entryMode == "Retrace into order block"
            int k = f_lastCandle(1, math.min(bar_index - sArm + 3, 300), true)
            if k > 0
                lvl := low[k]          // last up-close candle before the move down
        else
            if bosS and not na(lastSL5Bar)
                int k0 = bar_index - lastSL5Bar
                int k = f_lastCandle(k0, math.min(k0 + 5, 300), false)
                if k >= 0
                    lvl := low[k]      // last down-close candle at the low that was broken
        if isLimit and not na(lvl) and lvl <= close
            lvl := na
        if na(lvl)
            nZoneS += 1
        else if usePDA and not (not na(hSwH) and not na(hSwL) and hSwH > hSwL and lvl > (hSwH + hSwL) / 2)
            nPdaS += 1
        else
            float stopPx  = math.round_to_mintick(sExt + stopBuf)
            float riskPts = stopPx - lvl
            float tpPx    = math.round_to_mintick(lvl - targetRR * riskPts)
            if not (riskPts > 0 and riskPts >= minRiskAtr * atrV) or (isLimit and close <= tpPx)
                nRiskS += 1
            else
                int qty = int(math.min(maxQty, math.max(1, math.floor(strategy.equity * riskPct / 100 / (riskPts * syminfo.pointvalue)))))
                if isLimit
                    strategy.entry("Short", strategy.short, qty = qty, limit = math.round_to_mintick(lvl))
                    pendDir := -1
                    pendBar := bar_index
                    pendTP := tpPx
                else
                    strategy.entry("Short", strategy.short, qty = qty)
                strategy.exit("Short exit", from_entry = "Short", stop = stopPx, limit = tpPx)
                tradeTP := tpPx
                tradeSL := stopPx
                lastOrdDir := -1
                placed := true
                nOrdS += 1

// ---------------------------- Visuals ---------------------------------------
if barstate.islast and timeframe.period != "5"
    label.new(bar_index, high, "Run this script on the 5-minute chart", color = color.red, textcolor = color.white)

plot(showLevels and usePrevDay ? pdh : na, "Prev day high", color.new(color.blue, 30), style = plot.style_linebr)
plot(showLevels and usePrevDay ? pdl : na, "Prev day low", color.new(color.blue, 30), style = plot.style_linebr)
plot(showLevels and useAsia and not inAsia ? asiaH : na, "Asia high", color.new(color.purple, 30), style = plot.style_linebr)
plot(showLevels and useAsia and not inAsia ? asiaL : na, "Asia low", color.new(color.purple, 30), style = plot.style_linebr)
plot(showLevels and useLondon and not inLondon ? lonH : na, "London high", color.new(color.teal, 30), style = plot.style_linebr)
plot(showLevels and useLondon and not inLondon ? lonL : na, "London low", color.new(color.teal, 30), style = plot.style_linebr)
plot(showLevels and useHtfSw ? hSwH : na, "1h swing high", color.new(color.gray, 40), style = plot.style_linebr)
plot(showLevels and useHtfSw ? hSwL : na, "1h swing low", color.new(color.gray, 40), style = plot.style_linebr)

bool showTrade = strategy.position_size != 0 or pendDir != 0
plot(showTrade ? tradeTP : na, "Take profit", color.new(color.lime, 0), style = plot.style_linebr, linewidth = 2)
plot(showTrade ? tradeSL : na, "Stop loss", color.new(color.fuchsia, 0), style = plot.style_linebr, linewidth = 2)

plotshape(hiSweep, "Buy-side sweep", shape.triangledown, location.abovebar, color.new(color.red, 20), size = size.tiny)
plotshape(loSweep, "Sell-side sweep", shape.triangleup, location.belowbar, color.new(color.green, 20), size = size.tiny)
plotshape(confS, "Bearish confirmation", shape.xcross, location.abovebar, color.red, size = size.tiny)
plotshape(confL, "Bullish confirmation", shape.xcross, location.belowbar, color.green, size = size.tiny)

bgcolor(canTrade ? color.new(color.gray, 94) : na)

// ---------------------------- Funnel table ----------------------------------
f_row(table t, int r, string label, string a, string b) =>
    table.cell(t, 0, r, label, text_color = color.white, bgcolor = color.new(color.black, 25), text_halign = text.align_left)
    table.cell(t, 1, r, a, text_color = color.white, bgcolor = color.new(color.black, 25))
    table.cell(t, 2, r, b, text_color = color.white, bgcolor = color.new(color.black, 25))
    true

var table diag = table.new(position.top_right, 3, 14, border_width = 1)
if barstate.islast and showDiag
    f_row(diag, 0, "Funnel", "Long", "Short")
    f_row(diag, 1, "Liquidity sweeps", str.tostring(nSwL), str.tostring(nSwS))
    f_row(diag, 2, "Confirmations (BOS/IFVG)", str.tostring(nConfL), str.tostring(nConfS))
    f_row(diag, 3, "Confirmed outside window / news day", str.tostring(nWinL), str.tostring(nWinS))
    f_row(diag, 4, "Blocked: in a trade / max trades", str.tostring(nBlkL), str.tostring(nBlkS))
    f_row(diag, 5, "Filtered: against 1h trend", str.tostring(nBiasL), str.tostring(nBiasS))
    f_row(diag, 6, "Filtered: no SMT", str.tostring(nSmtL), str.tostring(nSmtS))
    f_row(diag, 7, "No entry zone found", str.tostring(nZoneL), str.tostring(nZoneS))
    f_row(diag, 8, "Filtered: wrong side of equilibrium", str.tostring(nPdaL), str.tostring(nPdaS))
    f_row(diag, 9, "Skipped: risk too small", str.tostring(nRiskL), str.tostring(nRiskS))
    f_row(diag, 10, "Orders placed", str.tostring(nOrdL), str.tostring(nOrdS))
    f_row(diag, 11, "Limit orders cancelled unfilled", str.tostring(nCxlL), str.tostring(nCxlS))
    f_row(diag, 12, "Trades filled", str.tostring(nFillL), str.tostring(nFillS))
    f_row(diag, 13, "1h trend now", hTrend == 1 ? "Bullish" : hTrend == -1 ? "Bearish" : "None", "")
